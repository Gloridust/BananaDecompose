# Required. Server-side only — never exposed to the browser.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional model overrides (defaults shown).
# Image generation / editing (Nano Banana 2)
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Vision + reasoning: scene planning, OCR, layout reading (cheap + GA)
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash

# Optional attribution headers shown on the OpenRouter dashboard
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=BananaDecompose
# Grounding / segmentation masks. Kept separate: the 3.x Pro line documents
# box_2d + segmentation-mask output, the Flash line does not. Switchable in the UI.
OPENROUTER_GROUNDING_MODEL=google/gemini-3.1-pro-preview
